{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pipeloom",
  "version": "0.1.0",
  "identifier": "io.github.knobo.pipeloom",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "Pipeloom", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["deb"], "icon": ["icons/icon.png"] }
}
