{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pipeloom",
  "version": "0.1.0",
  "identifier": "io.github.knobo.pipeloom",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Pipeloom",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Music",
    "shortDescription": "A calm GUI for PipeWire and WirePlumber",
    "longDescription": "Self-untangling PipeWire graph, devices with readable Bluetooth codec profiles, every WirePlumber setting, and a searchable catalog of config-file options.",
    "license": "MIT",
    "homepage": "https://github.com/knobo/pipeloom",
    "publisher": "Knut Olav Bøhmer",
    "linux": {
      "deb": {
        "depends": [
          "pipewire-bin",
          "wireplumber"
        ]
      },
      "rpm": {
        "depends": [
          "pipewire",
          "wireplumber"
        ]
      }
    }
  }
}
